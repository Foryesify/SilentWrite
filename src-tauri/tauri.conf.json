{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SilentWrite",
  "mainBinaryName": "SilentWrite",
  "version": "0.0.0",
  "identifier": "SilentWrite",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SilentWrite",
        "width": 1100,
        "height": 740,
        "minWidth": 640,
        "minHeight": 420,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "backgroundColor": "#202020"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
